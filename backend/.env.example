# PostgreSQL Database Connection URL (e.g., Supabase, Neon, Railway, ElephantSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/civicfix?schema=public&sslmode=require"

# JWT Token Secret Key
JWT_SECRET="replace-with-a-secure-production-secret-key"

# Server Port
PORT=5000

# Community Upvote Escalation Threshold
VOTE_THRESHOLD=10

# Deployed Frontend Web URL (For CORS Authorization)
FRONTEND_URL="https://your-civicfix-frontend-url.vercel.app"

# Optional Cloudinary Persistent Cloud Media Storage (Recommended for Production)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
